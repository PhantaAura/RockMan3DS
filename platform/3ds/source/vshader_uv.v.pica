; Legends3DS 0.0.14.4 textured hardware probe shader.
; Position/color retain the 0.0.14.3 layout; v2 adds normalized UV.

.fvec projection[4], modelView[4]

.constf constants(0.0, 1.0, -1.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outclr color
.out outtex texcoord0

.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mov outclr, inclr
    ; Match the official textured example: initialize the entire output.
    ; Only XY have TEXCOORD0 semantics; no new texture-W claim is made.
    mov outtex, intex
    end
.end
