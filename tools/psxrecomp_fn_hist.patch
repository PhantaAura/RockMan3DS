         int xw = g_xprobe_watch(target);  /* record RESOLUTION path for watched targets */
         xprobe_event(pc, XOP_JAL, XSITE_INTERP, target,
                      fetch_word((pc + 4) & 0x1FFFFFFFu), site_sp, cpu->gpr[31], 1);
diff --git a/runtime/src/fntrace.c b/runtime/src/fntrace.c
index 6b08fcd7..7b6fe1a8 100644
--- a/runtime/src/fntrace.c
+++ b/runtime/src/fntrace.c
@@ -130,7 +130,13 @@ static uint32_t s_spdom_prev_sp = 0;
 DispTailEntry g_disp_tail[DISP_TAIL_CAP];
 uint64_t      g_disp_tail_seq = 0;
 
+#ifndef PSX_NO_DEBUG_TOOLS
+extern void psx_fn_hist_hit(int table, uint32_t addr);
+#endif
 void fntrace_record(CPUState* cpu, uint32_t target) {
+#ifndef PSX_NO_DEBUG_TOOLS
+    psx_fn_hist_hit(1, target);
+#endif
     /* The BIOS has completed the PS-X EXE load by the time it dispatches the
      * entry point. Apply the validated plan before the first guest instruction. */
     mod_runtime_on_dispatch(target);
